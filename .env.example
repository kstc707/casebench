# Copy to apps/web/.env.local for local development.

# Postgres connection string. Local: postgres://localhost/casebench
# Hosted (Neon/Supabase): use the pooled connection string they give you.
DATABASE_URL=

# Server-side only. Without it the app runs in offline mode (scripted agents,
# heuristic grading).
ANTHROPIC_API_KEY=

# Optional model overrides.
# CASEBENCH_AGENT_MODEL=claude-haiku-4-5
# CASEBENCH_EVALUATOR_MODEL=claude-opus-5-5
# CASEBENCH_AI_PROVIDER=anthropic   # or "mock" to force offline mode

# Optional: serve DuckDB's engine from /public/duckdb instead of the jsDelivr CDN
# (run `pnpm --filter @casebench/web duckdb:local` first).
# NEXT_PUBLIC_DUCKDB_BUNDLE=local

# Optional: override where role-pack content is read from.
# CASEBENCH_CONTENT_ROOT=

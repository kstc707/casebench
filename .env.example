# Copy to apps/web/.env.local for local development.

# Postgres connection string. Local: postgres://localhost/casebench
# Hosted (Neon/Supabase): use the pooled connection string they give you.
DATABASE_URL=

# AI provider: set ONE key (auto-detected). Without any, the app runs in
# offline mode (scripted agents, heuristic grading). See docs/deploy.md.
GEMINI_API_KEY=          # free tier: aistudio.google.com
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=     # paid, best quality

# Optional overrides (defaults depend on the provider; see packages/ai/src/config.ts).
# CASEBENCH_AI_PROVIDER=gemini      # anthropic | gemini | groq | openrouter | ollama | openai-compatible | mock
# CASEBENCH_AGENT_MODEL=
# CASEBENCH_EVALUATOR_MODEL=
# CASEBENCH_LLM_BASE_URL=           # for openai-compatible
# CASEBENCH_LLM_API_KEY=

# Optional: serve DuckDB's engine from /public/duckdb instead of the jsDelivr CDN
# (run `pnpm --filter @casebench/web duckdb:local` first).
# NEXT_PUBLIC_DUCKDB_BUNDLE=local

# Optional: override where role-pack content is read from.
# CASEBENCH_CONTENT_ROOT=

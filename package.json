    "review-pack": "node scripts/review-pack.mjs"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.0.0"
}
